{
  "schemaVersion": "1.0",
  "rootPath": "swift.xctoolchain/usr/bin",
  "swiftCompiler": {
    "path": "swiftc",
    "extraCLIOptions": ["-static-stdlib", "-Xfrontend", "-enable-objc-interop"]
