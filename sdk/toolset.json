{
  "schemaVersion": "1.0",
  "rootPath": "swift.xctoolchain/usr/bin",
  "swiftCompiler": {
    "path": "swiftc",
    "extraCLIOptions": [
      "-static-stdlib",
      "-Xfrontend",
      "-enable-objc-interop",
      "-Xfrontend",
      "-validate-tbd-against-ir=none",
      "-Xfrontend",
      "-disable-objc-attr-requires-foundation-module"
    ]
  },
  "cCompiler": {
    "path": "clang",
    "extraCLIOptions": [
      "-fobjc-runtime=ios-7.0"
    ]
  },
  "cxxCompiler": {
    "path": "clang++",
    "extraCLIOptions": [
      "-fobjc-runtime=ios-7.0"
    ]
  },
  "linker": {
    "path": "wasm-ld"
  }
}